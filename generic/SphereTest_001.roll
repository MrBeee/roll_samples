        <angles azimin="0.0" refmin="0.0" refmax="30.0" azimax="360.0"/>
        <offset ymin="-9999.0" rmax="99999.0" ymax="9999.0" xmax="9999.0" xmin="-9999.0" rmin="0.0"/>
        <unique apply="False" deltaoff="200.0" deltaazi="5.0" write="False"/>
